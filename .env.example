# Loam Logger Mobile Environment Variables
# Copy this file to .env and fill in your values


# Expo Router - app directory location
EXPO_ROUTER_APP_ROOT=./app


# API URL - use localhost for development, production URL for releases
EXPO_PUBLIC_API_URL=http://localhost:4000


# Google OAuth Client IDs
# Web Client ID - used for token verification (same as backend GOOGLE_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com


# iOS Client ID - created in Google Cloud Console with bundle ID: com.loamlabs.loamlogger
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com


# Sentry DSN - error tracking (production only, disabled in dev)
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# Google Maps key for Android maps (ride recording and ride detail).
# Read by app.config.ts at build time; without it Android shows a placeholder
# instead of the map. Create it in Google Cloud with "Maps SDK for Android"
# enabled, restricted to Android apps: package com.loamlabs.loamlogger plus the
# SHA-1 of the signing key. Use a separate key for local builds, restricted to
# the debug keystore's SHA-1. Never commit a real key: this repo is public.
GOOGLE_MAPS_ANDROID_API_KEY=

# RevenueCat public SDK keys, one per store (src/lib/revenuecat.ts picks by
# platform). These are public keys, safe to commit; eas.json sets them for
# production builds. Find them in RevenueCat under each app's API keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your-ios-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your-android-key
